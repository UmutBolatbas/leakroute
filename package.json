{
  "name": "leakroute",
  "version": "1.0.0",
  "description": "Catch unprotected API endpoints and leaked secrets in AI-generated code before they ship.",
  "license": "MIT",
  "author": "UmutBolatbas",
  "type": "module",
  "bin": {
    "leakroute": "lib/cli.js"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "vendor/grammars",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "build:action": "node scripts/build-action.mjs",
    "prepublishOnly": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\" && npm run check"
  },
  "keywords": [
    "security",
    "secrets",
    "secret-scanning",
    "authentication",
    "authorization",
    "static-analysis",
    "github-action",
    "sarif",
    "ai-generated-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmutBolatbas/leakroute.git"
  },
  "bugs": {
    "url": "https://github.com/UmutBolatbas/leakroute/issues"
  },
  "homepage": "https://github.com/UmutBolatbas/leakroute#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@typescript-eslint/typescript-estree": "^8.71.1",
    "commander": "^14.0.3",
    "ignore": "^7.0.12",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "typescript": "~6.0.3",
    "web-tree-sitter": "^0.27.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
